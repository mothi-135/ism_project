# Server Port
PORT=5000

# Frontend URL for CORS (e.g., https://your-app.vercel.app)
FRONTEND_URL=http://localhost:5173

# Option 1: Full Database Connection String (Recommended for Neon, Supabase, Render, Vercel Postgres)
# DATABASE_URL=postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require

# Option 2: Individual Database Parameters (Local Development)
DB_USER=postgres
DB_HOST=localhost
DB_NAME=ism-info
DB_PORT=5432
DB_PASSWORD=your_database_password_here
